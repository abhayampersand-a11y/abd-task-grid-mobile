# Where the Next.js API lives, as reachable FROM THE PHONE.
# Use your machine's LAN IP — `localhost` resolves to the phone itself.
# Find it with `ipconfig` (Windows) or `ifconfig` (macOS/Linux).
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000

# Google AdMob. Everything below is optional: with none of it set the app runs
# with ads switched off in release builds, and on Google's test units in dev.
#
# The two APP ids (the `~` ones) are read by app.config.js at build time and
# written into the native manifest. The four UNIT ids (the `/` ones) are read by
# lib/ads.tsx. All six come from the AdMob console, and the unit ids are per
# platform — an Android unit will not fill on iOS.
#
# Never point a debug build at a live unit id: requesting real ads from a
# development build is invalid traffic and AdMob suspends accounts over it.
# lib/ads.tsx already forces the test units whenever __DEV__ is true.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
